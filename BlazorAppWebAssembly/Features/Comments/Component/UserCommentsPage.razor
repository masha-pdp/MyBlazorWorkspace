@page "/usercomments/{userId:long}"
@using BlazorAppWebAssembly.Features.Comments.DTO




<h3>User @userId comments:</h3>


@if (comments == null)
{
    <p>The user has no comments.</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var c in comments)
        {
            <li class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
                <span>
                    <strong>@c.date.ToShortDateString()</strong>: @c.text
                </span>
                <span>
                    <button class="btn btn-sm btn-primary me-1" @onclick="() => EditComment(c.id)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteComment(c.id)">Delete</button>
                </span>
            </li>
        }
    </ul>
    
    @if (!string.IsNullOrEmpty(messageDel))
    {
        <div class="alert alert-success">@messageDel</div>
    }
    
    <button class="btn btn-primary mt-3" @onclick="AddComment">
        Add new comment
    </button>
}



@code {
    [Inject] HttpClient _httpClient { get; set; }
    [Inject] NavigationManager Navigation { get; set; }
    [Parameter] public long userId { get; set; }
    private List<CommentDto>? comments { get; set; }
    private string? messageDel;

    protected override async Task OnInitializedAsync()
    {
        comments = await _httpClient.GetFromJsonAsync<List<CommentDto>>($"api/Comments/by-userId/{userId}");
    }
    
    private void AddComment()
    {
        Navigation.NavigateTo($"/usercomments/{userId}/add");
    }

    private async Task DeleteComment(long commId)
    {
        
        var response = await _httpClient.DeleteAsync($"api/comments/{commId}");
        if (response.IsSuccessStatusCode)
        {
            messageDel = "Комментарий удалён";
            StateHasChanged(); 
            await Task.Delay(2000);
            Navigation.NavigateTo($"/usercomments/{userId}", forceLoad: true);
        }
        else
        {
            messageDel = "Ошибка удаления";
        }
    }
    
    private void EditComment(long commId)
    {
        Navigation.NavigateTo($"/comment/{commId}/edit");
    }
}