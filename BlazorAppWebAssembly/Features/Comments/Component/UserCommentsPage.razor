@page "/usercomments/{userId:long}"
@using BlazorAppWebAssembly.Features.Comments.DTO



<h3>User @userId comments:</h3>


@if (comments == null)
{
    <p>The user has no comments.</p>
}
else
{
    <ul>
        @foreach (var c in comments)
        {
            <li>@c.date.ToShortDateString(): @c.text</li>
        }
    </ul>
}

@code {
    [Inject] HttpClient _httpClient { get; set; }
    [Parameter] public long userId { get; set; }
    private List<CommentDto>? comments { get; set; }

    protected override async Task OnInitializedAsync()
    {
        comments = await _httpClient.GetFromJsonAsync<List<CommentDto>>($"api/Comments?userId={userId}");

    }
    
}