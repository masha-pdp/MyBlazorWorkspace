@page "/usercomments/{userId:long}/add"
@using BlazorAppWebAssembly.Features.Comments.DTO
@using Blazored.FluentValidation


<h3>AddComment</h3>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

<EditForm Model="@commentDto" OnValidSubmit="HandleValidSubmit">
    <FluentValidationValidator />

    <div class="mb-3">
        <label for="text">Comment:</label>
        <InputText id="text" class="form-control" @bind-Value="commentDto.text" />
        <ValidationMessage For="@(() => commentDto.text)" />
    </div>

    <button type="submit" class="btn btn-primary">Save Comment</button>
</EditForm>

@code {
    [Inject] HttpClient _httpClient { get; set; }
    [Inject] NavigationManager Navigation { get; set; }

    [Parameter] public long userId { get; set; }
    private CommentDto commentDto = new CommentDto();
    private string? message;

    protected override void OnInitialized()
    {
        commentDto.userid = userId;
        commentDto.date = DateTime.UtcNow;
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            var response = await _httpClient.PostAsJsonAsync("api/comments", commentDto);

            if (response.IsSuccessStatusCode)
            {
                message = "Comment was successfully added!";
                StateHasChanged(); // Обновим UI
                await Task.Delay(2000); // 
                Navigation.NavigateTo($"/usercomments/{userId}");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                message = $"Error: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            message = $"Unexpected error: {ex.Message}";
        }
    }
}


@* 1. Blazor components: InputText, InputDate *@
@* *@
@* не использовать MediatR, *@
@* а отправлять данные через HttpClient *@
@* и валидировать их просто с помощью CommentDtoValidator.Validate(commentDto) *@
@* 2. Fluent Validation *@
@* 3. post Dto to controller, apply validation, save data to DB *@